{
  "name": "MarketplaceListing",
  "type": "object",
  "properties": {
    "listingId": {
      "type": "string",
      "description": "Public listing reference, format MKT-YYYYMMDD-XXXXXX"
    },
    "sellerId": {
      "type": "string",
      "description": "Reference to MarketplaceSeller record"
    },
    "sellerUserId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "deliveryTime": {
      "type": "string"
    },
    "portfolioUrl": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "approved",
        "rejected",
        "changes_requested",
        "suspended",
        "delisted"
      ],
      "default": "pending"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "source": {
      "type": "string",
      "enum": [
        "google_form",
        "in_app",
        "admin"
      ],
      "default": "in_app",
      "description": "Where this listing came from"
    },
    "submissionId": {
      "type": "string",
      "description": "Google Form submission / row identifier"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Form submission timestamp"
    },
    "syncHash": {
      "type": "string",
      "description": "Hash of the submitted row, used to detect updated submissions"
    },
    "rejectionReason": {
      "type": "string"
    },
    "adminMessage": {
      "type": "string",
      "description": "Admin feedback when changes are requested"
    },
    "reviewedBy": {
      "type": "string"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "sellerId",
    "title",
    "category",
    "price",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}