{
  "name": "SupportMessage",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "sender": {
      "type": "string",
      "enum": [
        "user",
        "ai",
        "agent",
        "system"
      ]
    },
    "content": {
      "type": "string"
    },
    "isRead": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversationId",
    "userId",
    "sender",
    "content"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}