{
  "name": "BiometricCredential",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Base44 user id this biometric credential belongs to"
    },
    "credentialId": {
      "type": "string",
      "description": "WebAuthn credential id (base64url)"
    },
    "publicKey": {
      "type": "string",
      "description": "Public key of the credential (base64url COSE). Used to verify unlock attempts server-side."
    },
    "counter": {
      "type": "number",
      "default": 0,
      "description": "Signature counter, updated on each verified unlock"
    },
    "deviceLabel": {
      "type": "string",
      "description": "Friendly label for the registered device"
    },
    "transports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lastUsedAt": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form notes, up to 1000 characters"
    }
  },
  "required": [
    "userId",
    "credentialId",
    "publicKey"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}