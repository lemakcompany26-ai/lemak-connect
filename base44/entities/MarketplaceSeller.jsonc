{
  "name": "MarketplaceSeller",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Base44 user id if the seller has an app account"
    },
    "fullName": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "description": "Phone/WhatsApp number"
    },
    "accountType": {
      "type": "string",
      "enum": [
        "Individual",
        "Business",
        "Agency",
        "Freelancer",
        "Service Provider",
        "Digital Product Seller"
      ]
    },
    "category": {
      "type": "string",
      "description": "Primary service category"
    },
    "serviceTitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "deliveryTime": {
      "type": "string"
    },
    "portfolioUrl": {
      "type": "string"
    },
    "sellerTerms": {
      "type": "string"
    },
    "verificationInfo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "changes_requested",
        "suspended"
      ],
      "default": "pending"
    },
    "reviewNotes": {
      "type": "string",
      "description": "Admin feedback / review notes shared with the seller"
    },
    "rejectionReason": {
      "type": "string"
    },
    "reviewedBy": {
      "type": "string"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "google_form",
        "in_app"
      ],
      "default": "in_app"
    },
    "submissionId": {
      "type": "string",
      "description": "Google Form submission / row identifier"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Form submission timestamp"
    },
    "listingId": {
      "type": "string",
      "description": "Generated listing reference for this submission"
    }
  },
  "required": [
    "fullName",
    "email",
    "accountType",
    "status"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}