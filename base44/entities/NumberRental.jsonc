{
  "name": "NumberRental",
  "type": "object",
  "properties": {
    "rentalRef": {
      "type": "string",
      "description": "Public rental reference, format VN-YYYYMMDD-XXXXXX"
    },
    "transactionId": {
      "type": "string"
    },
    "listingId": {
      "type": "string",
      "description": "Reference to VirtualNumberListing. For live provider rentals: PROVIDER-A / PROVIDER-B"
    },
    "buyerUserId": {
      "type": "string"
    },
    "sellerUserId": {
      "type": "string",
      "description": "Base44 user id of the seller. 'system' for live provider rentals"
    },
    "service": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Total buyer amount held in escrow for this rental"
    },
    "sellerPayout": {
      "type": "number"
    },
    "commission": {
      "type": "number"
    },
    "product": {
      "type": "string",
      "enum": [
        "sms",
        "email"
      ],
      "description": "Live provider rentals only: SMS number or temporary email OTP address"
    },
    "provider": {
      "type": "string",
      "description": "Provider id for live rentals, e.g. fleexa"
    },
    "serverId": {
      "type": "string",
      "description": "Which OTP server (a / b) served this live rental"
    },
    "providerOrderId": {
      "type": "string",
      "description": "Provider-side order id used to poll for the OTP"
    },
    "deliveredHandle": {
      "type": "string",
      "description": "Live rentals only: the purchased phone number or email address, revealed to the renter"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "expired",
        "cancelled"
      ],
      "default": "active"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "End of the rental window; afterwards the workflow auto-refunds the buyer"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "buyerTypingAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the buyer was typing in the rental chat (typing indicator)"
    },
    "sellerTypingAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the seller was typing in the rental chat (typing indicator). For live provider rentals, refreshed while the OTP is being fetched"
    }
  },
  "required": [
    "listingId",
    "buyerUserId",
    "sellerUserId",
    "amount",
    "status",
    "expiresAt"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "data.buyerUserId": "{{user.id}}"
        },
        {
          "data.sellerUserId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}