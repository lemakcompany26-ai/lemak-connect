{
  "name": "Notification",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "transaction",
        "wallet",
        "payment",
        "marketplace",
        "virtual_number",
        "smm",
        "security",
        "system",
        "promotional"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "isRead": {
      "type": "boolean",
      "default": false
    },
    "actionUrl": {
      "type": "string",
      "description": "Optional in-app route to open when tapped"
    },
    "sentEmail": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form notes, up to 1000 characters"
    }
  },
  "required": [
    "userId",
    "type",
    "title",
    "message"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": false
  }
}