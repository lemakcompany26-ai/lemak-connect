{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Base44 user id owning this wallet"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "promotionalBalance": {
      "type": "number",
      "default": 0,
      "description": "Unfrozen promotional credits, tracked separately from normal wallet funds"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "frozen",
        "closed"
      ],
      "default": "active"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form notes, up to 1000 characters"
    }
  },
  "required": [
    "userId",
    "currency",
    "balance"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}