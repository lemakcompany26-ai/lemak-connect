{
  "name": "MarketplaceOrder",
  "type": "object",
  "properties": {
    "transactionId": {
      "type": "string"
    },
    "buyerUserId": {
      "type": "string"
    },
    "sellerId": {
      "type": "string",
      "description": "Reference to MarketplaceSeller"
    },
    "sellerUserId": {
      "type": "string",
      "description": "Base44 user id of the seller, when available"
    },
    "listingId": {
      "type": "string"
    },
    "listingTitle": {
      "type": "string"
    },
    "listingPrice": {
      "type": "number",
      "description": "Price of the listing at purchase time"
    },
    "buyerFee": {
      "type": "number",
      "description": "Buyer service fee charged at purchase"
    },
    "commission": {
      "type": "number",
      "description": "Marketplace commission (platform fee) charged on this order"
    },
    "platformFee": {
      "type": "number",
      "description": "Marketplace commission percentage applied at purchase time"
    },
    "amount": {
      "type": "number",
      "description": "Total buyer amount held in escrow"
    },
    "sellerPayout": {
      "type": "number"
    },
    "payoutStatus": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "manual"
      ],
      "default": "pending",
      "description": "manual = seller has no app account, payout done outside the platform"
    },
    "accountUrl": {
      "type": "string",
      "description": "Account/page/channel URL submitted by the seller at delivery (validated server-side)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "in_progress",
        "delivered",
        "disputed",
        "confirmed",
        "completed",
        "refunded",
        "cancelled"
      ],
      "default": "pending"
    },
    "deliveryDueAt": {
      "type": "string",
      "format": "date-time"
    },
    "deliveredAt": {
      "type": "string",
      "format": "date-time"
    },
    "testingStartedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the buyer started testing the delivered account"
    },
    "disputedAt": {
      "type": "string",
      "format": "date-time"
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time"
    },
    "payoutAt": {
      "type": "string",
      "format": "date-time"
    },
    "buyerTypingAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the buyer was typing in the order chat (typing indicator)"
    },
    "sellerTypingAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the seller was typing in the order chat (typing indicator)"
    }
  },
  "required": [
    "buyerUserId",
    "sellerId",
    "listingId",
    "amount",
    "status"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "data.buyerUserId": "{{user.id}}"
        },
        {
          "data.sellerUserId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}