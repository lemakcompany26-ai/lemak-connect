{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Base44 user id this profile belongs to"
    },
    "fullName": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "avatar": {
      "type": "string",
      "description": "URL to profile avatar"
    },
    "role": {
      "type": "string",
      "enum": [
        "customer",
        "seller",
        "moderator",
        "admin",
        "super_admin"
      ],
      "default": "customer"
    },
    "accountStatus": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "pending",
        "blocked"
      ],
      "default": "active"
    },
    "referredByPromoCode": {
      "type": "string"
    },
    "lastLoginAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "userId",
    "fullName",
    "username",
    "email"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": false
  }
}