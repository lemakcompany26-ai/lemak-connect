{
  "name": "MarketplaceListing",
  "type": "object",
  "properties": {
    "listingId": {
      "type": "string",
      "description": "Public listing reference, format MKT-YYYYMMDD-XXXXXX"
    },
    "sellerId": {
      "type": "string",
      "description": "Reference to MarketplaceSeller record"
    },
    "sellerUserId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "description": "Social platform for account listings, e.g. Facebook, TikTok, Instagram, X / Twitter, YouTube"
    },
    "accountKind": {
      "type": "string",
      "enum": [
        "Page",
        "Account",
        "Channel",
        "Profile"
      ],
      "description": "Whether the listing is a page, account, channel or profile"
    },
    "followersCount": {
      "type": "number",
      "description": "Follower or subscriber count as claimed by the seller"
    },
    "monetised": {
      "type": "boolean",
      "description": "Seller's monetisation claim; only shown as verified after admin review of evidence"
    },
    "niche": {
      "type": "string",
      "description": "Content niche / category"
    },
    "audienceCountry": {
      "type": "string"
    },
    "accountAgeYears": {
      "type": "number"
    },
    "averageViews": {
      "type": "number"
    },
    "averageLikes": {
      "type": "number"
    },
    "averageComments": {
      "type": "number"
    },
    "audienceAgeRange": {
      "type": "string"
    },
    "audienceGender": {
      "type": "string"
    },
    "revenueInfo": {
      "type": "string",
      "description": "Documented revenue information, only where legitimately verifiable"
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "unverified",
        "pending_review",
        "verified"
      ],
      "default": "unverified",
      "description": "Admin-controlled. Sellers can never set this themselves; metrics only show as verified after admin review of evidence"
    },
    "deliveryMethod": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "deliveryTime": {
      "type": "string"
    },
    "portfolioUrl": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "approved",
        "rejected",
        "changes_requested",
        "suspended",
        "delisted"
      ],
      "default": "pending"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "source": {
      "type": "string",
      "enum": [
        "google_form",
        "in_app",
        "admin"
      ],
      "default": "in_app",
      "description": "Where this listing came from"
    },
    "submissionId": {
      "type": "string",
      "description": "Google Form submission / row identifier"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Form submission timestamp"
    },
    "syncHash": {
      "type": "string",
      "description": "Hash of the submitted row, used to detect updated submissions"
    },
    "rejectionReason": {
      "type": "string"
    },
    "adminMessage": {
      "type": "string",
      "description": "Admin feedback when changes are requested"
    },
    "reviewedBy": {
      "type": "string"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "sellerId",
    "title",
    "category",
    "price",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}