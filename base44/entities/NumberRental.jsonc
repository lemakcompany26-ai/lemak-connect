{
  "name": "NumberRental",
  "type": "object",
  "properties": {
    "rentalRef": {
      "type": "string",
      "description": "Public rental reference, format VN-YYYYMMDD-XXXXXX"
    },
    "transactionId": {
      "type": "string"
    },
    "listingId": {
      "type": "string",
      "description": "Reference to VirtualNumberListing. For live provider rentals: PROVIDER-A / PROVIDER-B"
    },
    "buyerUserId": {
      "type": "string"
    },
    "sellerUserId": {
      "type": "string",
      "description": "Base44 user id of the seller. 'system' for live provider rentals"
    },
    "service": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "description": "Country of the assigned number, when known from the provider"
    },
    "amount": {
      "type": "number",
      "description": "Total buyer amount held in escrow for this rental"
    },
    "sellerPayout": {
      "type": "number"
    },
    "commission": {
      "type": "number"
    },
    "product": {
      "type": "string",
      "enum": [
        "sms",
        "email",
        "rent"
      ],
      "description": "Live provider rentals only: one-time SMS number, temporary email OTP address, or long-term rented number"
    },
    "duration": {
      "type": "string",
      "description": "Long-term rentals only: purchased length in months, e.g. '1', '3', '12'"
    },
    "autoRenew": {
      "type": "boolean",
      "default": false,
      "description": "Long-term rentals only: buyer opted to extend the rental when the period ends"
    },
    "provider": {
      "type": "string",
      "description": "Internal provider id for live rentals. Never exposed to customers."
    },
    "serverId": {
      "type": "string",
      "description": "Internal: which OTP server (a / b) served this live rental. Never exposed to customers."
    },
    "providerOrderId": {
      "type": "string",
      "description": "Internal provider-side order id used to poll for the OTP. Never exposed to customers."
    },
    "deliveredHandle": {
      "type": "string",
      "description": "Live rentals only: the purchased phone number or email address, revealed to the renter"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "expired",
        "cancelled"
      ],
      "default": "active"
    },
    "otpReceived": {
      "type": "boolean",
      "default": false,
      "description": "True once the provider authoritatively delivered a verification message"
    },
    "otpReceivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cancelRequestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time"
    },
    "refundStatus": {
      "type": "string",
      "enum": [
        "REFUND_NOT_ELIGIBLE",
        "REFUND_PENDING",
        "REFUNDED",
        "REFUND_FAILED"
      ],
      "description": "Refund state. Only backend functions may change it."
    },
    "refundAmount": {
      "type": "number",
      "default": 0
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "End of the rental window; afterwards the workflow auto-refunds the buyer"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "buyerTypingAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the buyer was typing in the rental chat (typing indicator)"
    },
    "sellerTypingAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the seller was typing in the rental chat (typing indicator). For live provider rentals, refreshed while the OTP is being fetched"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form notes, up to 1000 characters"
    }
  },
  "required": [
    "listingId",
    "buyerUserId",
    "sellerUserId",
    "amount",
    "status",
    "expiresAt"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "data.buyerUserId": "{{user.id}}"
        },
        {
          "data.sellerUserId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}