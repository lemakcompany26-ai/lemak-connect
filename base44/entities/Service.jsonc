{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique identifier, e.g. airtime, data, electricity"
    },
    "categoryId": {
      "type": "string",
      "description": "Reference to ServiceCategory"
    },
    "providerId": {
      "type": "string",
      "description": "Reference to Provider"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "displayOrder": {
      "type": "number",
      "default": 0
    },
    "minimumAmount": {
      "type": "number"
    },
    "maximumAmount": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "slug",
    "isActive"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}